# ================================
# PriceCompare GPU - Environment Variables
# ================================
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าให้ถูกต้อง
# cp .env.example .env

# ================================
# Server
# ================================
PORT=3000
NODE_ENV=development

# ================================
# Database (MySQL / MariaDB)
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=price_compare_db

# ================================
# Scraper Settings
# ================================
# ช่วงเวลา scrape (นาที) - ค่าเริ่มต้น 60 นาที
SCRAPE_INTERVAL_MINUTES=60

# Timeout ต่อ Request (วินาที)
SCRAPE_TIMEOUT_SECONDS=30

# จำนวนครั้งที่ Retry สูงสุด
SCRAPE_MAX_RETRIES=2

# หน่วงเวลาระหว่าง Request (วินาที)
SCRAPE_DELAY_SECONDS=5
